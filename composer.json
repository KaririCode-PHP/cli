{
    "name": "kariricode/cli",
    "description": "Professional developer toolchain for the KaririCode Framework — code generation, inspection, and ARFA 1.3 compliance checking.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "kariricode",
        "cli",
        "code-generation",
        "dpo",
        "arfa",
        "scaffold"
    ],
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org",
            "role": "Lead Architect"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "kariricode/console": "^4.6",
        "kariricode/contract": "^2.12"
    },
    "suggest": {
        "kariricode/parser": "Implements SyntaxTreeDumper, DiagnosticsSource or ComplianceEngine for inspect:ast, inspect:diagnostics and AST-precise check:arfa (ADR-011)",
        "kariricode/dependency-injection": "Binds BindingSource and the CLI services through CliServiceProvider",
        "kariricode/router": "Provides the routes a RouteSource adapter reports to inspect:router"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kcli"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "spec": "4.3.3"
        }
    },
    "scripts": {
        "phpstan": "kcode run phpstan analyse --memory-limit=768M --no-progress",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "complexity": [
            "@php tools/complexity.php src",
            "kcode run phpstan analyse -c phpstan-complexity.neon --no-progress"
        ],
        "test": "kcode test",
        "test-conformance": "kcode test --testsuite Conformance",
        "infection": "kcode run infection --threads=max --only-covering-test-cases --no-progress",
        "psalm": "kcode run psalm --no-progress",
        "security": [
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php",
            "kcode test --group security"
        ],
        "sbom": "@php tools/sbom.php",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@security"
        ]
    }
}
