{
    "name": "kariricode/cli",
    "description": "Professional developer toolchain for the KaririCode Framework — code generation, inspection, and ARFA 1.3 compliance checking.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "kariricode",
        "cli",
        "code-generation",
        "dpo",
        "arfa",
        "scaffold"
    ],
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org",
            "role": "Lead Architect"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "kariricode/console": "^4.1",
        "kariricode/contract": "^2.11"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.29",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "tomasvotruba/cognitive-complexity": "^1.0",
        "vimeo/psalm": "^6.0"
    },
    "suggest": {
        "kariricode/parser": "Implements SyntaxTreeDumper, DiagnosticsSource or ComplianceEngine for inspect:ast, inspect:diagnostics and AST-precise check:arfa (ADR-011)",
        "kariricode/dependency-injection": "Binds BindingSource and the CLI services through CliServiceProvider",
        "kariricode/router": "Provides the routes a RouteSource adapter reports to inspect:router"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kcli"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "spec": "4.3.3"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=768M --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "complexity": [
            "@php tools/complexity.php src",
            "phpstan analyse -c phpstan-complexity.neon --no-progress"
        ],
        "test": "phpunit",
        "test-conformance": "phpunit --testsuite Conformance",
        "infection": "infection --threads=max --min-msi=80 --min-covered-msi=80 --only-covered --no-progress",
        "psalm": "psalm --no-progress",
        "security": [
            "@composer audit --locked",
            "@php tools/secret-scan.php",
            "phpunit --group security"
        ],
        "sbom": "@php tools/sbom.php",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@security"
        ]
    }
}
